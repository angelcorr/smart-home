<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.smarthome.controller.MainController"
            prefWidth="1050" prefHeight="680">

    <top>
        <ToolBar>
            <Button fx:id="undoButton" text="Undo" onAction="#onUndo" disable="true"/>
            <Button text="All off" onAction="#onAllOff"/>
            <Separator orientation="VERTICAL"/>
            <Label text="Add device:"/>
            <ComboBox fx:id="typeCombo" prefWidth="170"/>
            <TextField fx:id="nameField" promptText="Name" prefWidth="150"/>
            <ComboBox fx:id="roomCombo" prefWidth="140"/>
            <Button text="Add" onAction="#onAddDevice"/>
        </ToolBar>
    </top>

    <left>
        <VBox prefWidth="330" spacing="6" style="-fx-padding: 6 6 6 25;">
            <Label text="Home" style="-fx-font-weight: bold;"/>
            <TreeView fx:id="homeTree" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="14" style="-fx-padding: 16;">
            <Label fx:id="nameLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label fx:id="stateLabel"/>

            <HBox fx:id="powerBox" spacing="8">
                <Button text="Turn on" onAction="#onTurnOn"/>
                <Button text="Turn off" onAction="#onTurnOff"/>
            </HBox>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Security"/>
                <Button text="Arm home" onAction="#onArmHome"/>
                <Button text="Arm away" onAction="#onArmAway"/>
                <Button text="Disarm" onAction="#onDisarm"/>
                <Button text="Simulate motion" onAction="#onSimulateMotion"/>
            </HBox>

            <Label fx:id="securityLabel" text="Security: Disarmed"/>
            <HBox fx:id="brightnessBox" spacing="8" alignment="CENTER_LEFT">
                <Label text="Brightness"/>
                <Slider fx:id="brightnessSlider" min="0" max="100" prefWidth="260"
                        showTickLabels="true" majorTickUnit="25"/>
            </HBox>

            <HBox fx:id="climateBox" spacing="8" alignment="CENTER_LEFT">
                <Label text="Mode"/>
                <ComboBox fx:id="strategyCombo" prefWidth="140"/>
                <Label text="Room temp (°C)"/>
                <TextField fx:id="tempField" prefWidth="70"/>
                <Button text="Set" onAction="#onSetTemperature"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="4" style="-fx-padding: 25 20 25 20;">
            <Label text="Event log" style="-fx-font-weight: bold;"/>
            <ListView fx:id="logList" prefHeight="140"/>
        </VBox>
    </bottom>
</BorderPane>
